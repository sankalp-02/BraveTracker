{
    "manifest_version": 3,
    "name": "BraveTracker",
    "description": "Personal Brave browser tracking extension.",
    "version": "1.0.0",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background/background.js"
    },
    "action": {
        "default_title": "BraveTracker",
        "default_popup": "popup/popup.html"
    }
}